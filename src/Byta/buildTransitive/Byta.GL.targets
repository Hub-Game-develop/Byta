<Project>

  <!--
    让内置原生实现真正落到使用方的输出目录。

    为什么需要这个文件：NuGet 的 runtimes/<rid>/native 约定**只在对项目指定了
    RuntimeIdentifier（或 dotnet publish -r）时才复制**。框架依赖的普通项目
    （不写 RID，最常见的情况）拿到的只是 NuGet 缓存里的一份副本，输出目录里
    什么都没有 —— 于是 BytaRuntime 找不到 libEGL，安静地回退到系统实现，
    用户会以为"内置 4.6 没用上"。

    这里显式把 <包>/runtimes/osx-arm64/native 下的内容复制到
    <输出目录>/runtimes/osx-arm64/native，保持目录结构（dri/ 子目录必须保留，
    Mesa 靠它找驱动模块）。

    不想要这 208 MB 的话，在项目里设置：
      <BytaIncludeBundledNative>false</BytaIncludeBundledNative>

    ⚠️ 复制放在 Target 里、且默认值不在顶层写成 true，是必须的：
       Byta.Browser 会在自己的 targets 里把 BytaIncludeBundledNative 设为 false。
       如果这里在导入阶段就算出 _BytaCopyBundled=true（顶层 ItemGroup 求值早于
       那个 PropertyGroup），装了 Byta.Browser 的 Blazor 项目照样会被拷进 208 MB
       —— 实测就是这样。判断必须延迟到 Target 执行。
  -->

  <PropertyGroup>
    <_BytaBundledNativeRoot>$(MSBuildThisFileDirectory)..\native\osx-arm64\</_BytaBundledNativeRoot>
  </PropertyGroup>

  <Target Name="BytaCopyBundledNativeToBuild"
          AfterTargets="Build"
          Condition="'$(BytaIncludeBundledNative)' != 'false' and $([MSBuild]::IsOSPlatform('OSX')) and Exists('$(_BytaBundledNativeRoot)')">
    <ItemGroup>
      <_BytaNativeFileToBuild Include="$(_BytaBundledNativeRoot)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BytaNativeFileToBuild)"
          DestinationFolder="$(OutDir)runtimes\osx-arm64\native\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BytaCopyBundledNativeToPublish"
          AfterTargets="Publish"
          Condition="'$(BytaIncludeBundledNative)' != 'false' and $([MSBuild]::IsOSPlatform('OSX')) and Exists('$(_BytaBundledNativeRoot)')">
    <ItemGroup>
      <_BytaNativeFileToPublish Include="$(_BytaBundledNativeRoot)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BytaNativeFileToPublish)"
          DestinationFolder="$(PublishDir)runtimes\osx-arm64\native\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
