<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Byta</AssemblyName>
    <RootNamespace>Byta</RootNamespace>
    <PackageId>Byta.GL</PackageId>
    <Title>Byta — 现代、零分配开销的 .NET OpenGL 封装</Title>
    <Description>面向 .NET 的现代 OpenGL 封装：gl.xml 生成的零开销绑定 + 值句柄对象层 + 线程局部状态缓存，热路径零托管分配。实现可插拔：自带 Mesa(EGL, GL 4.6 core) 优先，其次 BYTA_GL_DRIVER 指定的实现，最后回退系统实现（macOS 上即 Apple 的 GL 4.1）。</Description>
    <PackageReadmeFile>PACKAGE-README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Byta.Bindings\Byta.Bindings.csproj" />
  </ItemGroup>

  <!-- 包内 README（用绝对图片地址，nuget.org 上也能显示） -->
  <ItemGroup>
    <None Include="..\..\PACKAGE-README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- 随包分发的原生实现。注意体积约 208 MB（LLVM 占 161 MB），压缩后进包。
       runtimes/<rid>/native 这条约定在**不带 RuntimeIdentifier 的项目里不会复制到输出目录**，
       所以必须靠 buildTransitive 的 targets 显式落地，否则使用方永远拿不到内置实现。 -->
  <ItemGroup>
    <!-- 刻意不用 runtimes/<rid>/native 这个约定路径：SDK 会对它做"当前 RID 的 native
         资产自动复制到输出目录"，完全绕过 BytaIncludeBundledNative 开关（实测装了
         Byta.Browser 的 Blazor 项目照样被拷进 208MB）。放到 native/ 下，由
         buildTransitive/Byta.GL.targets 里的 Target 统一控制。 -->
    <None Include="runtimes\osx-arm64\native\**\*" Pack="true" PackagePath="native\osx-arm64\" />
    <None Include="buildTransitive\Byta.GL.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
