<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:docs="using:Byta.Docs"
             x:Class="Byta.Docs.Views.DocsView">

  <UserControl.Styles>
    <!-- 成员卡片：Fluent 的层次感靠"淡背景 + 细边框"，而不是阴影 -->
    <Style Selector="Border.MemberCard">
      <Setter Property="Background" Value="#0F1620" />
      <Setter Property="BorderBrush" Value="#1E2733" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="TextBlock.Sig">
      <Setter Property="FontFamily" Value="Menlo,Consolas,'Cascadia Mono',monospace" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="#9ED0FF" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.Doc">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#8C9AAD" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,5,0,0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBlock.KindTag">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="#6E7E93" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Background="#0A0D12">

    <!-- ── 标题栏 ───────────────────────────────────────────── -->
    <Border Grid.Row="0" Padding="26,20,26,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Byta" FontSize="26" FontWeight="SemiBold" Foreground="#E8F1FF" />
            <Border Background="#14243A" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
              <TextBlock x:Name="VersionText" Text="API" FontSize="11" Foreground="#7FB8FF" />
            </Border>
          </StackPanel>
          <TextBlock Text="现代、零分配开销的 .NET OpenGL 封装"
                     FontSize="12.5" Foreground="#7B8AA0" />
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Column="1" Width="280" Height="34"
                 VerticalAlignment="Center"
                 Watermark="搜索类型或成员（如 GlBuffer / Draw）"
                 TextChanged="OnSearchChanged" />
      </Grid>
    </Border>

    <!-- ── 统计条（FluentUI-CodeHub 的 FAInfoBar） ─────────────── -->
    <fa:FAInfoBar Grid.Row="1" x:Name="StatsBar"
                  Margin="26,0,26,10"
                  Severity="Informational"
                  IsOpen="True"
                  IsClosable="False"
                  IsIconVisible="True" />

    <!-- ── 主体：左列表 + 右详情 ─────────────────────────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="330,*">

      <Border Grid.Column="0" BorderBrush="#161E29" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock x:Name="ListHeader" Grid.Row="0" Margin="26,14,0,8"
                     FontSize="11" Foreground="#6E7E93" Text="全部类型" />
          <ListBox x:Name="TypeList" Grid.Row="1" Margin="12,0,8,16"
                   Background="Transparent"
                   SelectionChanged="OnTypeSelected">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,4" Spacing="1">
                  <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#DCE6F2"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="#5F6E82" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" Padding="26,14,26,30">
        <StackPanel Spacing="14">

          <!-- 未选中时的骨架占位（FluentUI-CodeHub 的 FASkeleton） -->
          <StackPanel x:Name="EmptyState" Spacing="12">
            <TextBlock Text="从左侧选择一个类型" FontSize="13" Foreground="#6E7E93" />
            <fa:FASkeleton IsLoading="True" Height="18" Width="240" HorizontalAlignment="Left" />
            <fa:FASkeleton IsLoading="True" Height="14" Width="360" HorizontalAlignment="Left" />
            <fa:FASkeleton IsLoading="True" Height="14" Width="300" HorizontalAlignment="Left" />
            <fa:FASkeleton IsLoading="True" Height="14" Width="330" HorizontalAlignment="Left" />
          </StackPanel>

          <!-- 类型详情 -->
          <StackPanel x:Name="DetailPanel" Spacing="14" IsVisible="False">

            <StackPanel Spacing="6">
              <TextBlock x:Name="TypeKind" FontSize="11" Foreground="#7FB8FF"
                         Text="struct" />
              <TextBlock x:Name="TypeName" FontSize="23" FontWeight="SemiBold"
                                   Foreground="#E8F1FF" TextWrapping="Wrap" />
              <TextBlock x:Name="TypeFullName" FontSize="11.5" Foreground="#5F6E82"
                         TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="TypeSummary" FontSize="13" Foreground="#96A5B8"
                       TextWrapping="Wrap" IsVisible="False" />

            <Border x:Name="TruncatedNote" IsVisible="False"
                    Background="#1A1408" BorderBrush="#3A2E12" BorderThickness="1"
                    CornerRadius="6" Padding="12,8">
              <TextBlock x:Name="TruncatedText" FontSize="12" Foreground="#D6BC6A" />
            </Border>

            <TextBlock x:Name="MembersHeader" FontSize="11" Foreground="#6E7E93"
                       Margin="0,6,0,0" />

            <ItemsControl x:Name="MemberList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="MemberCard" Margin="0,0,0,7">
                    <StackPanel>
                      <TextBlock Classes="KindTag" Text="{Binding KindLabel}" />
                      <TextBlock Classes="Sig" Text="{Binding Signature}" />
                      <TextBlock Classes="Doc" Text="{Binding Summary}"
                                 IsVisible="{Binding HasSummary}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Grid>
</UserControl>
